{
  "default": "main",
  "tcbs": {
    "main": {
      "models": [
        {
          "provider": "siliconflow",
          "model": "deepseek-ai/DeepSeek-V3.2",
          "temperature": 0.7,
          "maxTokens": 16384
        },
        {
          "provider": "siliconflow",
          "model": "deepseek-ai/DeepSeek-V3.1-Terminus",
          "temperature": 0.7,
          "maxTokens": 16384
        },
        {
          "provider": "siliconflow",
          "model": "deepseek-ai/DeepSeek-V3",
          "temperature": 0.7,
          "maxTokens": 16384
        }
      ],
      "identity": "data/identity/YOUR-PERSONA.md",
      "sections": [
        "deployment:persona-prefix",
        "deployment:persona-suffix",
        "tool-packages",
        "tool:pwsh",
        "tool:read",
        "tool:write",
        "tool:edit",
        "tool:glob",
        "tool:grep",
        "tool:web_search",
        "tool:web_fetch",
        "tool:subagent",
        "tool:jobs",
        "tool:session-query"
      ]
    },
    "vlm": {
      "models": [
        {
          "provider": "siliconflow",
          "model": "Qwen/Qwen3-VL-32B-Instruct",
          "temperature": 0.2,
          "maxTokens": 2048
        },
        {
          "provider": "siliconflow",
          "model": "Qwen/Qwen3-VL-8B-Instruct",
          "temperature": 0.2,
          "maxTokens": 2048
        },
        {
          "provider": "siliconflow",
          "model": "Qwen/Qwen3.5-27B",
          "temperature": 0.2,
          "maxTokens": 2048
        },
        {
          "provider": "siliconflow",
          "model": "Qwen/Qwen3.5-9B",
          "temperature": 0.2,
          "maxTokens": 2048
        }
      ],
      "sections": []
    },
    "planner": {
      "model": {
        "provider": "siliconflow",
        "model": "Qwen/Qwen3.5-27B",
        "temperature": 0.3,
        "maxTokens": 512
      },
      "identity": "data/identity/YOUR-PLANNER-PERSONA.md",
      "sections": [
        "deployment:persona-prefix"
      ]
    }
  }
}
